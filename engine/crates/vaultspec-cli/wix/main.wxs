<?xml version='1.0' encoding='windows-1252'?>
<!--
  The product-owned Windows Installer package.

  This MSI installs the COMPLETE composed product tree, never a bare binary: the
  dashboard executable, the copied external updater, the release manifest, every
  license, and the SBOM. Every one of those files is carried by its own component
  so Windows Installer owns install, repair, and removal of each individually.

  NO AGENT-TO-AGENT RUNTIME IS PACKAGED, and that absence is a decision rather
  than an oversight. The dashboard resolves that runtime from the invoking user's
  app home, never from this install directory, and no shipped operation populates
  that location yet - adoption is declared but not implemented. Packaging a copy
  here would add several hundred megabytes of files the product never reads. It
  returns to this package when adoption is implemented.

  BUILD CONTRACT. The package is compiled against an already-composed product
  tree, not against a cargo target directory. The build must define:

    ProductTreeDir  The composed generation root to package (the directory that
                    holds release.json).
    LicensesDir     <ProductTreeDir>\licenses
    Version         The product version for this package.

  One file set has build-decided membership rather than a fixed roster, so it
  arrives as a harvested fragment carrying ONE COMPONENT PER FILE:

    heat dir <ProductTreeDir>\licenses -cg LicenseFiles -dr LICENSESDIR \
        -var var.LicensesDir -srd -sreg -scom -gg -g1 -sfrag -out licenses.wxs

  That fragment is compiled and linked alongside this file. A missing variable
  or a missing file fails the build loudly; nothing here degrades to a partial
  payload.

  The link step reports ICE61 ("this product should remove only older versions of
  itself"): that is the expected, deliberate consequence of allowing downgrades
  below, not a defect to paper over.

  Portions of this file derive from the cargo-wix template,
  Copyright (C) 2017 Christopher R. Field, licensed under the Apache License,
  Version 2.0 (http://www.apache.org/licenses/LICENSE-2.0). Distributed on an
  "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND.
-->

<?ifndef ProductTreeDir ?>
    <?error The ProductTreeDir preprocessor variable must name the composed product tree to package. ?>
<?endif ?>

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='vaultspec'
        UpgradeCode='51ED63D0-D794-406A-8F96-ED09840177B1'
        Manufacturer='vaultspec contributors'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='The complete vaultspec product: the dashboard, its external updater, and its release manifest, licenses, and SBOM, installed offline as one verified release set.'
            Manufacturer='vaultspec contributors'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <!-- Windows Installer owns activation for this channel. Downgrades are
             ALLOWED because the declared downgrade path for the MSI channel is
             reinstalling the prior versioned product package; blocking them would
             leave that path unimplementable. -->
        <MajorUpgrade
            Schedule='afterInstallInitialize'
            AllowDowngrades='yes'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='vaultspec Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <!-- Launching the bare binary IS the application front door: it
                 attaches to (or starts) the one machine seat and opens the
                 browser. -->
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='vaultspec'/>
            </Directory>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='vaultspec'>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='C3A8A117-69C2-4305-B00F-CECFF92D204F' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <!-- The dashboard executable: also the shipped authority
                             this package's uninstall custom actions drive. -->
                        <Component Id='DashboardBinary' Guid='5FB34DEF-273E-4922-8DAC-6976E779A616'>
                            <File
                                Id='DashboardExe'
                                Name='vaultspec.exe'
                                DiskId='1'
                                Source='$(var.ProductTreeDir)\bin\vaultspec.exe'
                                KeyPath='yes'/>
                        </Component>
                        <!-- The copied external updater: it replaces the release
                             from OUTSIDE the active seat under the installation
                             lock, so it must be present in the installed tree. -->
                        <Component Id='UpdaterBinary' Guid='E194CC76-BF4B-4CE9-B785-E461A93ADF85'>
                            <File
                                Id='UpdaterExe'
                                Name='vaultspec-updater.exe'
                                DiskId='1'
                                Source='$(var.ProductTreeDir)\bin\vaultspec-updater.exe'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>

                    <!-- Third-party license texts, one component per license. -->
                    <Directory Id='LICENSESDIR' Name='licenses'/>

                    <!-- The release-set member manifest: the digest evidence the
                         shipped verifier checks the installed tree against. -->
                    <Component Id='ReleaseManifest' Guid='53A43066-190E-4A60-AF68-3A7AB8C847D5'>
                        <File
                            Id='ReleaseJson'
                            Name='release.json'
                            DiskId='1'
                            Source='$(var.ProductTreeDir)\release.json'
                            KeyPath='yes'/>
                    </Component>

                    <Component Id='Sbom' Guid='C9B6A260-2026-4791-85A9-67FEAEFB5147'>
                        <File
                            Id='SbomJson'
                            Name='sbom.cdx.json'
                            DiskId='1'
                            Source='$(var.ProductTreeDir)\sbom.cdx.json'
                            KeyPath='yes'/>
                    </Component>

                    <!-- The durable install-provenance record: which channel owns
                         this copy, which version it is, and where it lives. It is
                         the component's key path, so Windows Installer removes it
                         with the product and no stale provenance survives an
                         uninstall. User data is NOT recorded here and NOT owned by
                         this package - it lives outside the install directory and
                         survives removal. -->
                    <Component Id='InstallProvenance' Guid='6249B45E-9AE3-4418-AAC1-F991064E103D'>
                        <RegistryKey Root='HKLM' Key='SOFTWARE\vaultspec\install'>
                            <RegistryValue Name='channel' Type='string' Value='msi' KeyPath='yes'/>
                            <RegistryValue Name='version' Type='string' Value='$(var.Version)'/>
                            <RegistryValue Name='location' Type='string' Value='[APPLICATIONFOLDER]'/>
                        </RegistryKey>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <DirectoryRef Id='ApplicationProgramsFolder'>
            <Component Id='ApplicationShortcut' Guid='9D5B2E44-30FA-4B1C-8F0D-4E6A2C7B91D3'>
                <Shortcut
                    Id='ApplicationStartMenuShortcut'
                    Name='vaultspec'
                    Description='Open the vaultspec dashboard'
                    Target='[!DashboardExe]'
                    WorkingDirectory='Bin'/>
                <RemoveFolder Id='CleanUpShortcutFolder' Directory='ApplicationProgramsFolder' On='uninstall'/>
                <RegistryValue Root='HKCU' Key='Software\vaultspec\dashboard' Name='installed' Type='integer' Value='1' KeyPath='yes'/>
            </Component>
        </DirectoryRef>

        <!-- UNINSTALL SEMANTICS. Before any file is removed, the shipped binary
             is asked to stop the running seat (otherwise open files force a
             reboot) and then to drop the product's own owned state - generations,
             receipt, and credentials - which it does while PRESERVING user data.
             Both run impersonated, because that state lives in the invoking
             user's app home rather than the machine account's.

             Their return value is ignored deliberately: an uninstall must not be
             blockable by the product's own state, and anything they leave behind
             lives outside this package's file set where the product itself can
             still remove it. -->
        <CustomAction Id='StopRunningProduct'
            FileKey='DashboardExe'
            ExeCommand='stop'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore'/>
        <CustomAction Id='DropProductReceipt'
            FileKey='DashboardExe'
            ExeCommand='a2a remove'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore'/>

        <InstallExecuteSequence>
            <Custom Action='StopRunningProduct' Before='DropProductReceipt'>REMOVE~="ALL"</Custom>
            <Custom Action='DropProductReceipt' Before='RemoveFiles'>REMOVE~="ALL"</Custom>
        </InstallExecuteSequence>

        <!-- The payload is complete or it is nothing: the product tree cannot be
             deselected, so no partial installation can be produced from this
             package. Only the two conveniences are optional. -->
        <Feature
            Id='ProductTree'
            Title='vaultspec'
            Description='The complete product: the dashboard, its external updater, the release manifest, licenses, and the SBOM.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='DashboardBinary'/>
            <ComponentRef Id='UpdaterBinary'/>
            <ComponentRef Id='ReleaseManifest'/>
            <ComponentRef Id='Sbom'/>
            <ComponentRef Id='InstallProvenance'/>
            <ComponentGroupRef Id='LicenseFiles'/>

            <Feature
                Id='StartMenuShortcut'
                Title='Start Menu Shortcut'
                Description='Add a Start Menu shortcut that opens the vaultspec dashboard.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='ApplicationShortcut'/>
            </Feature>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of the [ProductName] executable to the PATH system environment variable. This allows the [ProductName] executable to be called from any location.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/nevenincs/vaultspec-dashboard'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>

    </Product>

</Wix>
