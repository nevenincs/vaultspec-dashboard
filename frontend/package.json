{
  "name": "vaultspec-dashboard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.5.2",
  "description": "vaultspec-dashboard SPA — decoupled web GUI served by the engine's serve mode (gui-spec §5)",
  "scripts": {
    "readme:capture": "node dev/tooling/capture-readme.mjs",
    "dev": "vite",
    "dev:visual-review": "vite --config vite.dev.config.ts",
    "graph:dev": "vite --host 127.0.0.1 --port 8775 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src dev",
    "lint:localization": "node dev/tooling/scan-localization.mjs",
    "lint:px": "node dev/tooling/scan-px.mjs",
    "lint:domains": "node dev/tooling/scan-domains.mjs",
    "lint:modules": "node dev/tooling/scan-module-size.mjs",
    "lint:design-system": "node dev/tooling/scan-design-system.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"dev/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"dev/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test --config dev/playwright.config.ts",
    "e2e:agent": "playwright test --config dev/playwright.agent.config.ts",
    "e2e:editor": "playwright test --config dev/playwright.editor.config.ts",
    "tokens:build": "node style-dictionary.config.ts && prettier --write src/styles.css",
    "tokens:check": "node dev/tooling/token-drift-check.ts",
    "tokens:figma": "node dev/tooling/figma-export.ts",
    "figma:names": "node dev/tooling/figma-names-check.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "culori": "^4.0.2",
    "d3-force": "^3.0.0",
    "dockview": "^6.6.1",
    "i18next": "26.4.2",
    "lucide-react": "^1.47.0",
    "material-icon-theme": "5.38.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "17.0.14",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.7",
    "style-dictionary": "^5.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "brace-expansion@2.0.0 - 2.1.3": "2.1.4",
    "brace-expansion@3.0.0 - 5.0.8": "5.0.9",
    "qs@2.2.5 - 6.15.3": "6.16.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
