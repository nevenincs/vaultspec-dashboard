# =============================================================================
# vaultspec-dashboard environment variables
# =============================================================================
#
# These are read directly from the process environment (`export FOO=...`,
# or your shell/service manager's env block) — the dashboard loads no dotenv
# file at runtime, so copying this file anywhere has no effect on its own.
#
# Installed commands:
#   vaultspec-dashboard
#
# =============================================================================


# -----------------------------------------------------------------------------
# Core subprocess bounds
# -----------------------------------------------------------------------------

# Ceiling on a single vaultspec-core verb's stdout, in MiB. A value below 1 is
# clamped up to 1.
# Type: integer (MiB) | Default: 64
# VAULTSPEC_CORE_STDOUT_CAP_MIB=64

# Wall-clock ceiling, in seconds, for a single vaultspec-core verb. A hung
# child past this deadline is killed. 0 disables the timeout.
# Type: integer (seconds) | Default: 120
# VAULTSPEC_CORE_TIMEOUT_SECS=120

# -----------------------------------------------------------------------------
# Worktree and git status concurrency
# -----------------------------------------------------------------------------

# How many worktrees are inspected concurrently when enumerating a workspace.
# 0 or unset uses the default.
# Type: integer | Default: 4
# VAULTSPEC_WORKTREE_INSPECT_THREADS=4

# Thread cap for a single worktree's git status diff. 0 uses gix's own
# per-core default instead of a fixed cap.
# Type: integer | Default: 2
# VAULTSPEC_GIT_STATUS_THREADS=2

# -----------------------------------------------------------------------------
# Diagnostics and demo
# -----------------------------------------------------------------------------

# Set (to any value) to log graph-indexing phase timings.
# Type: presence flag | Default: unset (off)
# VAULTSPEC_INDEX_TIMING=1

# Set to "1" to enable the simulated demo conditions (loading/error/empty)
# used by the visual review desk. Never set this on a production serve.
# Type: "1" | Default: unset (off)
# VAULTSPEC_DEMO_CONDITIONS=1

# -----------------------------------------------------------------------------
# Filesystem locations
# -----------------------------------------------------------------------------

# Overrides the on-disk SPA asset directory served in dev builds (ignored by
# a release binary with the SPA embedded).
# Type: Path | Default: <workspace>/frontend/dist
# VAULTSPEC_SPA_DIR=./frontend/dist

# Overrides the machine-global app home (seat discovery, launcher state).
# Type: Path | Default: ~/.vaultspec (from USERPROFILE/HOME)
# VAULTSPEC_APP_HOME=~/.vaultspec

# Overrides the machine-global a2a home (resident a2a service discovery).
# Type: Path | Default: ~/.vaultspec-a2a (from USERPROFILE/HOME)
# VAULTSPEC_A2A_HOME=~/.vaultspec-a2a
